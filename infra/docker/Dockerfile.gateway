FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY src/DomainMind.Gateway/ DomainMind.Gateway/
RUN dotnet restore DomainMind.Gateway/DomainMind.Gateway.csproj
RUN dotnet publish DomainMind.Gateway/DomainMind.Gateway.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
ENTRYPOINT ["dotnet", "DomainMind.Gateway.dll"]
