FROM python:3.11-slim AS runtime
WORKDIR /app
COPY services/pyproject.toml .
RUN pip install --no-cache-dir fastapi uvicorn httpx pydantic pydantic-settings qdrant-client
COPY services/retrieval/ retrieval/
ENV PYTHONPATH=/app
EXPOSE 8001
CMD ["uvicorn", "retrieval.main:app", "--host", "0.0.0.0", "--port", "8001"]
